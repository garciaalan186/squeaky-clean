MODULE OrderView
LAYER Interface
EXPORTS [OrderPresenter]
DEPENDS []
CLASSES {
  OrderPresenter -> Presenter {
    methods: [present(order: Order): OrderViewModel]
  }
  Order -> SimpleClass {
    fields: [id: str, total: float, status: str]
    methods: [getId(): str, getTotal(): float, getStatus(): str]
  }
  OrderViewModel -> SimpleClass {
    fields: [id: str, formattedTotal: str, status: str]
    invariants: ["view model holds id, formatted total, and status"]
  }
}
