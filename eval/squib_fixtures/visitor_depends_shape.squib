MODULE NodeVisitorMod
LAYER Domain
EXPORTS [NodeVisitor]
DEPENDS []
CLASSES {
  NodeVisitor -> Visitor {
    methods: [visitTreeNode(node: TreeNode): void]
  }
  PrintVisitor -> Visitor {
    methods: [visitTreeNode(node: TreeNode): void]
    depends: [NodeVisitor]
  }
  CountVisitor -> Visitor {
    methods: [visitTreeNode(node: TreeNode): void]
    depends: [NodeVisitor]
  }
  TreeNode -> SimpleClass {
    methods: [describe(): str]
  }
}
