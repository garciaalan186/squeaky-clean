MODULE ApprovalHandlerMod
LAYER Domain
EXPORTS [ApprovalHandler]
DEPENDS []
CLASSES {
  ApprovalHandler -> ChainOfResponsibility {
    methods: [handle(request: ApprovalRequest): bool]
  }
  ManagerApproval -> ChainOfResponsibility {
    methods: [handle(request: ApprovalRequest): bool]
    depends: [ApprovalHandler]
  }
  DirectorApproval -> ChainOfResponsibility {
    methods: [handle(request: ApprovalRequest): bool]
    depends: [ApprovalHandler]
  }
  ApprovalRequest -> SimpleClass {
    fields: [amount: float]
    methods: [getAmount(): float]
  }
}
