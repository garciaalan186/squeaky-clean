MODULE UserApi
LAYER Application
EXPORTS [UserMapper]
DEPENDS []
CLASSES {
  UserMapper -> DTOMapper {
    methods: [to_dto(user: User): UserDto, to_domain(dto: UserDto): User]
  }
  User -> SimpleClass {
    fields: [id: str, name: str, email: str]
    methods: [getId(): str, getName(): str, getEmail(): str]
  }
  UserDto -> SimpleClass {
    fields: [id: str, name: str, email: str]
    methods: [getId(): str, getName(): str, getEmail(): str]
  }
}
