MODULE OrderLifecycle
LAYER Domain
EXPORTS [OrderState]
DEPENDS []
CLASSES {
  OrderState -> State {
    methods: [next(order: Order): OrderState]
    concretes: [PendingState, ShippedState]
  }
  Order -> SimpleClass {
    methods: [describe(): str]
  }
  PendingState -> SimpleClass {
    methods: [describe(): str]
  }
  ShippedState -> SimpleClass {
    methods: [describe(): str]
  }
}
