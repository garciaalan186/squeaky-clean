MODULE Documents
LAYER Application
EXPORTS [DocumentCreator]
DEPENDS []
CLASSES {
  DocumentCreator -> FactoryMethod {
    methods: [create_document(): Document]
    concretes: [PdfCreator, HtmlCreator]
  }
  Document -> SimpleClass {
    methods: [describe(): str]
  }
  HtmlCreator -> SimpleClass {
    methods: [describe(): str]
  }
  PdfCreator -> SimpleClass {
    methods: [describe(): str]
  }
}
