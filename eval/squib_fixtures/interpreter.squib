MODULE Expressions
LAYER Domain
EXPORTS [Expression]
DEPENDS []
CLASSES {
  Expression -> Interpreter {
    methods: [interpret(context: Context): int]
    concretes: [NumberExpr, AddExpr]
  }
  AddExpr -> SimpleClass {
    methods: [describe(): str]
  }
  Context -> SimpleClass {
    methods: [describe(): str]
  }
  NumberExpr -> SimpleClass {
    methods: [describe(): str]
  }
}
