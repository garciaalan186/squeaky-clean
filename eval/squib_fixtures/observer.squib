MODULE Notifications
LAYER Domain
EXPORTS [EventObserver]
DEPENDS []
CLASSES {
  EventObserver -> Observer {
    methods: [update(event: Event): void]
    concretes: [EmailObserver, SmsObserver]
  }
  EmailObserver -> SimpleClass {
    methods: [describe(): str]
  }
  Event -> SimpleClass {
    methods: [describe(): str]
  }
  SmsObserver -> SimpleClass {
    methods: [describe(): str]
  }
}
