MODULE Filesystem
LAYER Domain
EXPORTS [Directory]
DEPENDS []
CLASSES {
  Directory -> Composite {
    implements: Node
    fields: [children: Node]
    methods: [size(): int, add(child: Node): void]
  }
  Node -> SimpleClass {
    methods: [size(): int, add(child: Node): void]
    concretes: [Directory]
  }
}
