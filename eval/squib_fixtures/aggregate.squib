MODULE Orders
LAYER Domain
EXPORTS [Order]
DEPENDS []
CLASSES {
  Order -> Aggregate {
    fields: [id: str, lines: OrderLine]
    methods: [add_line(line: OrderLine): void, total(): Money]
    invariants: ["order total must be non-negative"]
  }
  Money -> SimpleClass {
    fields: [amount: float]
    methods: [zero(): Money, add(other: Money): Money, isNegative(): bool]
  }
  OrderLine -> SimpleClass {
    fields: [amount: Money]
    methods: [getAmount(): Money]
  }
}
