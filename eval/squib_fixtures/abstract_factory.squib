MODULE Theming
LAYER Domain
EXPORTS [WidgetFactory]
DEPENDS []
CLASSES {
  WidgetFactory -> AbstractFactory {
    methods: [create_button(): Button, create_checkbox(): Checkbox]
    concretes: [DarkWidgetFactory, LightWidgetFactory]
  }
  Button -> SimpleClass {
    methods: [describe(): str]
  }
  Checkbox -> SimpleClass {
    methods: [describe(): str]
  }
  DarkWidgetFactory -> SimpleClass {
    methods: [describe(): str]
  }
  LightWidgetFactory -> SimpleClass {
    methods: [describe(): str]
  }
}
